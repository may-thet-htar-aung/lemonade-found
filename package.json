{
  "name": "lemonade-found",
  "private": true,
  "version": "0.1.0",
  "description": "Lemonade Found: Public Website, Mobile App and Back Office, built on the Lemonade design system.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:website": "npm run dev -w @lemonade-found/website",
    "dev:mobile": "npm run dev -w @lemonade-found/mobile",
    "dev:back-office": "npm run dev -w @lemonade-found/back-office",
    "build": "npm run build --workspaces"
  },
  "dependencies": {
    "@may_thet_htar_aung/lemonade-design-system": "0.3.3"
  }
}
